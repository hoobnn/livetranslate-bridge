      }
    },
    "settings.segmentation.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server ends a turn after this much silence; streaming text may appear earlier. Default: 1000 ms. For narrated lessons or long sentences, try 1500 ms. The 400 ms low-latency option can split breathing pauses. Longer windows reduce fragmentation at the cost of waiting longer; they do not guarantee complete sentences.\nSensitivity controls speech detection: lower values include quieter speech and more noise.\nChanges apply to the next session."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务端在静音达到设定时长后结束语音段，流式文字可能更早出现。默认 1000 毫秒；听力、讲解或长句可选 1500 毫秒。400 毫秒偏向低延迟，容易把换气切成新段。调长可减少碎切，但等待更久，也不保证语义完整。\n灵敏度控制人声检测：数值越低，越容易识别微弱人声，也越容易包含噪声。\n修改在下一次启动会话时生效。"
          }
        }
      }
    },
