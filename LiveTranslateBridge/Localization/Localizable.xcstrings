{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "app.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Translate Bridge"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时通话字幕"
          }
        }
      }
    },
    "audio.backlog" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice backlog exceeded 15 seconds. Remaining audio in this response was skipped; subtitles continue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "译声积压超过 15 秒，本句后续语音已跳过；字幕继续更新。"
          }
        }
      }
    },
    "audio.duckOriginal" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower original audio while translation speaks"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "译声播放时自动降低原声音量"
          }
        }
      }
    },
    "audio.feedbackRoute" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input and mixed output use the same device. Stop and choose a separate microphone to avoid feedback."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入与混音输出是同一设备，会重复采集译声。请停止后选择独立麦克风。"
          }
        }
      }
    },
    "audio.inputMissing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected microphone disconnected. Waiting for it to return without switching inputs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选麦克风已断开，等待设备恢复；不会改用其他输入。"
          }
        }
      }
    },
    "audio.outputMissing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected output unavailable. Reconnect it, or stop to choose another device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选输出设备不可用，请重新连接或停止后选择其他设备。"
          }
        }
      }
    },
    "audio.outputUnavailable" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio output could not start. Subtitles remain available; check the selected device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频输出启动失败，字幕仍可使用；请检查所选设备。"
          }
        }
      }
    },
    "audio.skipSpeech" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip speech"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过译声"
