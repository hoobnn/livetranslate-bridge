    "diagnostics.maintenance.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taps and aggregate devices are global Core Audio objects; a crash leaves them behind in Audio MIDI Setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "tap 与聚合设备是 Core Audio 的全局对象，进程崩溃后会残留在「音频 MIDI 设置」里。"
          }
        }
      }
    },
    "diagnostics.maintenance.sweep": {
      "extractionState": "manual",
