          "stringUnit": {
            "state": "translated",
            "value": "Press Start, then play audio in the selected app. Both sides are translated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「开始」，然后让所选应用播放声音。两侧内容都会被翻译。"
