    "empty.idle.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Start, then answer the call on your iPhone. Both sides are translated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「开始」后接听 iPhone 来电。双方的话都会被翻译。"
          }
        }
      }
    },
    "empty.idle.message.localOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Start and talk. Only your microphone is captured, translated into the other language — no call needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「开始」然后说话。只采集你的麦克风，译成对方的语言——不需要通话。"
          }
        }
      }
    },
    "empty.idle.message.localOnly.transcribe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Start and talk. Only your microphone is captured and written down — no call needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「开始」然后说话。只采集你的麦克风并记成文字——不需要通话。"
          }
        }
      }
    },
    "empty.idle.message.transcribe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the language each side speaks, press Start, then take the call on your iPhone. Both sides are written down in their own language; nothing is translated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选好两边各自说的语言，点「开始」，然后用 iPhone 接听来电。两边都按原话记成文字，不做翻译。"
          }
        }
      }
    },
