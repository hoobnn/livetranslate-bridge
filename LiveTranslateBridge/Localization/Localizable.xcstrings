    "settings.voice.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both directions of the call are always translated and subtitled. This only decides whether your side is also spoken aloud, and where. Continuity relay takes your side of the call from the system default input, so the far end hears the translation only if it is played into a loopback device that is also the default input."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话双向始终翻译并显示字幕。这里只决定你这一侧要不要同时播报、播到哪里。接力通话从系统默认输入设备读取你这一侧的声音，所以只有播到一个同时被设为默认输入的回环设备，对方才听得到译文。"
          }
        }
      }
    },
