          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 qwen3.8，对有译声输出的方向生效：我的音色复刻一次，所选应用每次回复更新音色。复刻失败会明确提示，不会静默切换模型或音色。"
          }
        }
      }
    },
