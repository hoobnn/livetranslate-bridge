            "value": "Clones your timbre once at the start of the call and reuses it. Without this the stock voice is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话开始时克隆一次你的音色并沿用。不开启则使用默认音色。"
          }
        }
      }
    },
    "settings.voice.currentInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call reads its microphone from"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话的麦克风来自"
          }
        }
      }
    },
    "settings.voice.currentInput.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知"
          }
        }
      }
    },
    "settings.voice.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play into"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放到"
          }
        }
      }
    },
    "settings.voice.device.loopback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "can feed the call"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可回灌通话"
          }
        }
      }
    },
    "settings.voice.device.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't speak — subtitles only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不播报，只显示字幕"
          }
        }
      }
    },
    "settings.voice.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both directions of the call are always translated and subtitled. This only decides whether your side is also spoken aloud, and where. Continuity relay takes your side of the call from the system default input, so the far end hears the translation only if it is played into a loopback device that is also the default input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话双向始终翻译并显示字幕。这里只决定你这一侧要不要同时播报、播到哪里。接力通话从系统默认输入设备读取你这一侧的声音，所以只有播到一个同时被设为默认输入的回环设备，对方才听得到译文。"
          }
        }
      }
    },
    "settings.voice.howto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a loopback device, set it as the default input in Sound settings, then pick it above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装回环设备，在「声音」设置里把它设为默认输入，然后在上面选中它。"
          }
        }
      }
    },
    "settings.voice.input": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture my voice from"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这里采集我的声音"
          }
        }
      }
    },
    "settings.voice.input.default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the system default input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统默认输入"
          }
        }
      }
    },
    "settings.voice.input.loopback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "loopback — would capture the translation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回环设备，会采到译文"
          }
        }
      }
    },
    "settings.voice.input.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setup captures the spoken translation and translates it again. Since the translation is being spoken, pick your real microphone here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设置会让译文被重新采集并再翻译一次。既然要播报译文，请在这里明确选中你的真实麦克风。"
          }
        }
      }
    },
    "settings.voice.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新设备"
          }
        }
      }
    },
    "settings.voice.remoteOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the far end is being captured, so there is nothing of yours to speak. Capture your own side to use these."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前只采集对方，没有你的话可以播报。要用这些选项，请把采集范围改成包含自己这边。"
          }
        }
      }
    },
    "settings.voice.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking my translation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播报我的译文"
          }
        }
      }
    },
    "settings.voice.transcribe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription produces no translation, so nothing is spoken. Switch back to Translate to use these."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录模式不产生译文，因此不会播报。要用这些选项，请切回翻译模式。"
          }
        }
      }
