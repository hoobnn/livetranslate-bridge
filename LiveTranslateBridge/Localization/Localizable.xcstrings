    "settings.segmentation.faster": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快"
          }
        }
      }
    },
    "settings.segmentation.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation only starts once this pause has elapsed, so it is added to the latency of every line. A shorter pause gets words on screen sooner, but a speaker drawing breath mid-sentence can read as finished — and the sentence is then split and each half translated without the other's context. A quiet one-on-one call takes 300–400 ms; a speaker who pauses to think, or a noisy room, wants more.\nSensitivity sets how loud a sound has to be to count as speech: lower it when a quiet talker produces no subtitles at all, raise it when keyboard or room noise keeps triggering them.\nBoth apply after the current session stops."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕要等这段停顿结束才会开始翻译，因此它直接加在每一句的延迟上。调短出字更快，但说话人中途换气也可能被当成说完，把一句话拆成两半分别翻译。安静的一对一通话可以用 300–400 毫秒；讲话时常停顿思考，或环境嘈杂，就往长了调。\n灵敏度决定多大的声音才算人声：对方声音小、字幕迟迟不出现就调低，键盘声或环境噪声频繁触发就调高。\n两项都在停止当前会话后生效。"
          }
        }
      }
    },
