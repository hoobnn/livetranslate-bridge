      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear queued speech and skip the rest of the current response, keeping original audio and subtitles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空待播译声并跳过当前回复剩余语音，保留原声与字幕。"
          }
        }
      }
    },
